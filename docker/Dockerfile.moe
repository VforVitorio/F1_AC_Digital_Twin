# Dockerfile for MoE Anomaly Detector Service
# Consumes telemetry from Kafka, runs MoE inference, publishes anomalies

FROM python:3.11-slim

WORKDIR /app

# Install system dependencies for confluent-kafka
RUN apt-get update && apt-get install -y \
    librdkafka-dev \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements and install Python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy source code
COPY src/ ./src/
COPY scripts/ ./scripts/
COPY config.py .
COPY .env .

# Models are mounted as volume at runtime
# Volume: ./models:/app/models:ro

# Set Python path
ENV PYTHONPATH=/app
ENV PYTHONUNBUFFERED=1

# Run the MoE consumer
CMD ["python", "scripts/streaming/kafka_moe_consumer.py"]
